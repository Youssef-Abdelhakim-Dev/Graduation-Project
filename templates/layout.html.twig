<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Zagazig University{% endblock %}</title>

    <!-- Google Fonts (Poppins) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <!-- Tailwind CSS & AOS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css">

    <!-- Swiper -->
    <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/projectGraduation/styles/index.css">

    {% block styles %}{% endblock %}
</head>
<body>
    <!-- Progress Bar -->
    <div class="progress-bar-container">
        <div class="progress-bar"></div>
    </div>

    <!-- Navbar -->
    {% include 'partials/navbar.html.twig' %}

    <!-- Page Content -->
    <div class="container mx-auto mt-24 p-6">
        {% block content %}{% endblock %}
    </div>

    <!-- Footer -->
    {% include 'partials/footer.html.twig' %}

    <!-- JS Libraries -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.0/dist/sweetalert2.all.min.js"></script>
    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.10.1/gsap.min.js"></script>
    <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
    <script src="https://unpkg.com/tippy.js@6.3.1/dist/tippy.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    {% block scripts %}
<script>
// =========================
// Mobile Menu Toggle
// =========================
document.getElementById('menu-btn').addEventListener('click', function () {
    document.getElementById('mobile-menu').classList.toggle('hidden');
});


// =========================
// Counter Animation
// =========================
function animateCounter(id, endValue) {
    let start = 0;
    const speed = 50;
    const counter = setInterval(() => {
        document.getElementById(id).innerText = ++start;
        if (start >= endValue) clearInterval(counter);
    }, speed);
}

setTimeout(() => {
    animateCounter("student-count", 50000);
    animateCounter("faculty-count", 5000);
}, 1000);


// =========================
// AOS INIT
// =========================
AOS.init({
    duration: 1000,
    once: true,
    delay: 200,
});


// =========================
// Smooth Scroll Navigation
// =========================
document.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', function (e) {
        e.preventDefault();
        const section = document.querySelector(this.getAttribute('href'));
        if (section) {
            window.scrollTo({
                top: section.offsetTop - 80,
                behavior: 'smooth'
            });
        }
    });
});


// =========================
// SWEETALERT ROLE SELECTION
// =========================
document.getElementById('signin-btn').addEventListener('click', async () => {
    try {
        const { value: role } = await Swal.fire({
            title: '🔰 Select Your Role',
            input: 'radio',
            inputOptions: {
                admin: '🛠️ Admin',
                teacher: '👨‍🏫 Teacher',
                student: '🎓 Student'
            },
            inputValidator: v => (!v ? 'Please select a role!' : null),
            confirmButtonText: 'Next ⏭',
            showCancelButton: true,
            cancelButtonText: 'Cancel ❌',
            background: '#0f172a',
            color: '#F8FAFC',
            customClass: {
                popup: 'rounded-2xl shadow-2xl',
                confirmButton: 'bg-blue-500 hover:bg-blue-700 text-white px-4 py-2 rounded-full',
                cancelButton: 'bg-gray-700 hover:bg-gray-900 text-white px-4 py-2 rounded-full'
            }
        });

        if (role) {
            Swal.fire({
                title: `🎭 Redirecting as ${role}...`,
                html: `
                    <div class="loading-container">
                        <div class="spinner"></div>
                        <div class="skeleton-loader"></div>
                        <p class="loading-text">Preparing<span class="dots">.</span></p>
                        <div class="progress-ring">
                            <svg viewBox="0 0 50 50">
                                <circle cx="25" cy="25" r="20"></circle>
                            </svg>
                        </div>
                    </div>
                `,
                allowOutsideClick: false,
                showConfirmButton: false,
                background: 'rgba(15,23,42,0.95)',
                color: '#F8FAFC',
                didOpen: () => {
                    Swal.showLoading();
                    const dots = document.querySelector(".dots");

                    setInterval(() => {
                        dots.textContent = dots.textContent.length < 3 ? dots.textContent + '.' : '.';
                    }, 400);

                    gsap.to("circle", {
                        strokeDasharray: "125, 125",
                        duration: 3,
                        ease: "power2.inOut",
                        onComplete: () => {
                            window.location.href = `login_${role}.php`;
                        }
                    });

                    gsap.fromTo(".spinner", { scale: 0.8, opacity: 0.5 },
                        { scale: 1, opacity: 1, repeat: -1, yoyo: true, duration: 1.5 });
                }
            });
        }
    } catch (error) {
        Swal.fire({
            title: '❌ Error',
            text: 'Something went wrong!',
            icon: 'error',
            background: '#1E293B',
            color: '#F8FAFC'
        });
    }
});


// =========================
// SCROLL EVENTS + PROGRESS BAR + NAV ACTIVATION
// =========================
document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('section');
    const navLinks = document.querySelectorAll('.nav-link');
    const progressBar = document.querySelector('.progress-bar');
    let isScrolling = false;

    function debounce(func, wait) {
        return () => {
            if (!isScrolling) {
                isScrolling = true;
                setTimeout(() => {
                    func();
                    isScrolling = false;
                }, wait);
            }
        };
    }

    const activateNavLink = () => {
        let current = null;
        sections.forEach(sec => {
            const rect = sec.getBoundingClientRect();
            if (rect.top <= window.innerHeight / 2 && rect.bottom >= window.innerHeight / 2) {
                current = sec;
            }
        });
        if (current) {
            const activeLink = document.querySelector(`a[href="#${current.id}"]`);
            navLinks.forEach(l => l.classList.remove('active'));
            activeLink.classList.add('active');
        }
    };

    const handleNavbarSticky = () => {
        const navbar = document.querySelector('nav');
        window.scrollY > 50 ? navbar.classList.add('sticky') : navbar.classList.remove('sticky');
    };

    const updateProgressBar = () => {
        const position = window.scrollY;
        const total = document.documentElement.scrollHeight - window.innerHeight;
        const progress = (position / total) * 100;
        progressBar.style.width = progress + "%";
    };

    const applyParallaxEffect = () => {
        sections.forEach(sec => {
            sec.classList.toggle('in-view', sec.getBoundingClientRect().top < window.innerHeight);
        });
    };

    const onScroll = debounce(() => {
        activateNavLink();
        handleNavbarSticky();
        updateProgressBar();
        applyParallaxEffect();
    }, 150);

    window.addEventListener('scroll', onScroll);

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            const link = document.querySelector(`a[href="#${entry.target.id}"]`);
            entry.target.classList.toggle('in-view', entry.isIntersecting);
            link.classList.toggle('active', entry.isIntersecting);
        });
    }, { threshold: 0.3 });

    sections.forEach(sec => observer.observe(sec));
});
</script>
    {% endblock %}
</body>
</html>
