{# templates/no_courses.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>No Courses Available</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-r from-blue-100 via-purple-100 to-pink-100 min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-gradient-to-r from-blue-600 via-indigo-700 to-purple-700 text-white py-8 shadow-md text-center rounded-b-3xl">
        <h1 class="text-4xl font-extrabold">Courses</h1>
        <p class="mt-2 text-lg opacity-90">Currently, no courses are available.</p>
    </header>

    <!-- Main Content -->
    <main class="flex-grow flex items-center justify-center p-8">
        <div class="text-center bg-white/70 backdrop-blur-md p-12 rounded-3xl shadow-lg animate-fade-in">
            <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-24 w-24 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2l4-4m1 7a9 9 0 11-18 0a9 9 0 0118 0z" />
            </svg>
            <h2 class="mt-6 text-2xl font-bold text-gray-800">No Courses Found</h2>
            <p class="mt-2 text-gray-600">We couldn't find any courses matching your search or filters.</p>
           
        </div>
    </main>

   
    <style>
        @keyframes fade-in {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fade-in 0.8s ease-out forwards;
        }
    </style>
</body>
</html>
