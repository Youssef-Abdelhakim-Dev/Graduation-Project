<section id="courses" data-aos="flip-left" class="card mt-10 bg-white p-6 rounded-lg shadow-lg hover:shadow-2xl transition-all duration-300">
    <br>
    <h2 class="text-3xl font-semibold"><i class="fas fa-book-reader text-blue-600"></i> Specializations: </h2>
   
    <ul id="course-list" class="space-y-4 mt-4">
        {% for course in specializations %}
            <li class="p-4 rounded-lg shadow-md transition-all duration-300">
                <h2 class="text-2xl font-semibold">{{ course.name }}</h2>
                <p class="text-gray-700">{{ course.description }}</p>
            </li>
        {% else %}
            <li class="text-gray-500">No specializations available.</li>
        {% endfor %}
    </ul>
</section>
